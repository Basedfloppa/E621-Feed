{
  "__inputs": [],
  "__requires": [],
  "title": "E621 Feed \u2014 Usage Analytics",
  "description": "Usage metrics for E621 Feed: active users, feature popularity, process health, catalog growth, and A/B experiment comparison (control vs exploration). Source: e621-feed /api/metrics",
  "tags": [
    "e621-feed",
    "prometheus",
    "ab-testing"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "panels": [
    {
      "title": "Daily Active Users (DAU)",
      "description": "Unique accounts that viewed feed, digest, or browse in the last 24h",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(sum by(account_id)(rate(e621_feed_views_total[24h]) or rate(e621_digest_views_total[24h]) or rate(e621_browse_views_total[24h])) > 0)",
          "legendFormat": "DAU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "Total Accounts",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "e621_accounts_total",
          "legendFormat": "Accounts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "purple",
                "value": 0
              }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "Accounts Created (24h)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(e621_accounts_created_total[24h]))",
          "legendFormat": "Created"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "Total Posts in Catalog",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "e621_catalog_posts_total",
          "legendFormat": "Posts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "Active Users (7d)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(sum by(account_id)(rate(e621_feed_views_total[7d]) or rate(e621_digest_views_total[7d]) or rate(e621_browse_views_total[7d])) > 0)",
          "legendFormat": "WAU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "Active Users (30d)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(sum by(account_id)(rate(e621_feed_views_total[30d]) or rate(e621_digest_views_total[30d]) or rate(e621_browse_views_total[30d])) > 0)",
          "legendFormat": "MAU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "green",
                "value": 15
              }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "Feature Usage \u2014 Last 7 Days",
      "description": "Requests per page type, rate per hour",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(e621_feed_views_total[5m]))",
          "legendFormat": "Feed"
        },
        {
          "expr": "sum(rate(e621_digest_views_total[5m]))",
          "legendFormat": "Digest"
        },
        {
          "expr": "sum(rate(e621_browse_views_total[5m]))",
          "legendFormat": "Browse"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "req/s"
        }
      }
    },
    {
      "title": "Browse Breakdown (trending vs favorites)",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(e621_browse_views_total{source=\"trending\"}[5m]))",
          "legendFormat": "Trending"
        },
        {
          "expr": "sum(rate(e621_browse_views_total{source=\"favorites\"}[5m]))",
          "legendFormat": "Favorites"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "req/s"
        }
      }
    },
    {
      "title": "/process Pipeline \u2014 Success Rate (7d)",
      "description": "Ratio of successful runs to total started",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(e621_process_runs_total{status=\"success\"}[7d])) / (sum(rate(e621_process_runs_total{status=\"started\"}[7d])) or vector(1)) * 100",
          "legendFormat": "Success %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        }
      }
    },
    {
      "title": "/process Pipeline Runs (24h)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(e621_process_runs_total{status=\"started\"}[5m]))",
          "legendFormat": "Started"
        },
        {
          "expr": "sum(rate(e621_process_runs_total{status=\"success\"}[5m]))",
          "legendFormat": "Success"
        },
        {
          "expr": "sum(rate(e621_process_runs_total{status=\"failed\"}[5m]))",
          "legendFormat": "Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "req/s"
        }
      }
    },
    {
      "title": "Catalog Growth",
      "type": "timeseries",
      "description": "Total posts in the local catalog over time",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "e621_catalog_posts_total",
          "legendFormat": "Catalog size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "Feed Interactions (24h)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(e621_feed_interactions_total[5m])) by (type)",
          "legendFormat": "{{ type }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "req/s"
        }
      },
      "description": "Feed interaction rate by event type (all buckets combined)"
    },
    {
      "title": "Top Accounts by Feed Views (24h)",
      "type": "bargauge",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "topk(10, sum by(account_id)(rate(e621_feed_views_total[24h])))",
          "legendFormat": "{{ account_id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        }
      }
    },
    {
      "title": "Top Accounts by Digest Views (24h)",
      "type": "bargauge",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "expr": "topk(10, sum by(account_id)(rate(e621_digest_views_total[24h])))",
          "legendFormat": "{{ account_id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      }
    },
    {
      "title": "Top Accounts by Browse Views (24h)",
      "type": "bargauge",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "expr": "topk(10, sum by(account_id)(rate(e621_browse_views_total[24h])))",
          "legendFormat": "{{ account_id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "purple",
                "value": 0
              }
            ]
          }
        }
      }
    },
    {
      "title": "A/B \u2014 Accounts per Bucket",
      "description": "Current account count in each experiment arm (gauge from accounts table)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "e621_experiment_bucket_accounts",
          "legendFormat": "{{ bucket }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "A/B \u2014 Interactions per Bucket (24h)",
      "description": "Feed interactions per arm (24h window)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 33
      },
      "targets": [
        {
          "expr": "increase(e621_experiment_bucket_interactions_total[24h])",
          "legendFormat": "{{ bucket }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "A/B \u2014 Engagement Rate",
      "description": "Positive actions (open/like/strong_like) per impression per arm. Higher = better recommendations.",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(e621_feed_interactions_total{type=~\"open|like|strong_like\"}[5m])) by (bucket) / clamp_min(sum(rate(e621_feed_interactions_total{type=\"qualified_impression\"}[5m])) by (bucket), 0.001)",
          "legendFormat": "{{ bucket }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "title": "A/B \u2014 Hide Rate",
      "description": "Hides per impression per arm. Lower = fewer misses.",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "expr": "sum(rate(e621_feed_interactions_total{type=\"hide\"}[5m])) by (bucket) / clamp_min(sum(rate(e621_feed_interactions_total{type=\"qualified_impression\"}[5m])) by (bucket), 0.001)",
          "legendFormat": "{{ bucket }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "short",
          "min": 0
        }
      }
    },
    {
      "title": "A/B \u2014 Interactions by Type & Bucket",
      "description": "Raw interaction rates split by arm and event type",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "expr": "sum(rate(e621_feed_interactions_total[5m])) by (bucket, type)",
          "legendFormat": "{{ bucket }} / {{ type }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "req/s"
        }
      }
    },
    {
      "title": "Cache Pruner \u2014 Entries Dropped",
      "type": "timeseries",
      "description": "Rate of cache entries dropped by the cache-pruner worker, split by category (api_ttl, api_idle, jobs, ratelimit, candidates, revoked, idf, relation)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum by (category) (rate(e621_cache_pruned_total[$__rate_interval]))",
          "legendFormat": "{{category}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "Process Job Wall Time (running)",
      "type": "timeseries",
      "description": "Age in seconds of the currently running /process job. Above 1800s (~30 min) signals a stuck or pathologically slow import.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "targets": [
        {
          "expr": "e621_process_running_seconds",
          "legendFormat": "Running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "title": "Last /process Duration (s)",
      "type": "stat",
      "description": "Wall-clock seconds of the most recently finished /process job.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 56
      },
      "targets": [
        {
          "expr": "e621_process_last_duration_seconds",
          "legendFormat": "Last"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "unit": "s"
        }
      }
    },
    {
      "title": "Prefetch Breaker Trips (24h)",
      "type": "stat",
      "description": "Times the catalog-prefetch circuit breaker opened in the last 24h (e621 failures exceeded prefetch_breaker_threshold).",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 56
      },
      "targets": [
        {
          "expr": "increase(e621_prefetch_breaker_trips_total[24h])",
          "legendFormat": "Trips"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        }
      }
    },
    {
      "title": "e621 Upstream Errors by Class (5m rate)",
      "type": "timeseries",
      "description": "Rate of outbound e621 failures split by class (5xx / 429 / 4xx / timeout / network / decode). Sustained 5xx/network = e621 outage; 429 = we are being rate-limited.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 62
      },
      "targets": [
        {
          "expr": "sum by (class) (rate(e621_upstream_errors_total[5m]))",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "unit": "req/s"
        }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 2
}