# ============================================================
# nginx — TLS terminator + reverse proxy for the single Rust
# binary that now serves BOTH the SPA (`/`) and the API (`/api`).
#
# Since the frontend is embedded in the API binary (see
# parser-api/build.rs + parser-api/src/serve_embedded.rs), nginx no
# longer serves static files from parser-web/dist. It only:
#   * terminates TLS,
#   * proxies everything to the API binary on :8080,
#   * keeps Let's Encrypt ACME on :80.
# ============================================================

# The API binary serves the SPA, static assets and /api itself, so all
# security/cache headers are owned by the application and pass through
# the proxy. nginx only needs compression for upstream responses.

# ------------------------------------------------------------
# 1) HTTP (port 80): ACME + redirect to HTTPS
# ------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name domain.com www.domain.com;
    server_tokens off;

    # Let's Encrypt HTTP-01 challenge (must NOT be proxied to the app)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
    }

    # Everything else redirects to HTTPS on apex
    location / {
        return 301 https://domain.com$request_uri;
    }
}

# Map HTTP/1.1 Upgrade for WebSockets.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ------------------------------------------------------------
# 2) HTTPS (port 443): single reverse proxy to the API binary
# ------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name domain.com;
    server_tokens off;
    charset utf-8;

    # --- Compression (the embedded binary serves raw bytes) ---
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/html
        text/css
        text/plain
        application/wasm
        application/javascript
        application/json
        image/svg+xml
        application/octet-stream;

    # --- TLS ---
    ssl_certificate     /etc/letsencrypt/live/domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/domain.com/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # --- Security headers (sent on every proxied response) ---
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()" always;
    # CSP is set by the application (it knows the e621 media domain); do not
    # override it here so the app's dynamic policy wins.

    # --- Reverse proxy: SPA + /api + static all served by the binary ---
    location / {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # IMPORTANT: use $remote_addr (replace), not $proxy_add_x_forwarded_for
        # (append). The append form lets clients inject a leftmost spoofed IP,
        # bypassing per-IP rate-limiters that read XFF leftmost. nginx
        # terminates TLS here and is the single trusted hop, so $remote_addr
        # IS the real client IP.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (just in case)
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_read_timeout  300;
        proxy_send_timeout  300;

        client_max_body_size 50m;
    }
}

# ------------------------------------------------------------
# 3) explicit www -> apex on HTTPS
# ------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.domain.com;

    ssl_certificate     /etc/letsencrypt/live/domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/domain.com/privkey.pem;
    return 301 https://domain.com$request_uri;
}
