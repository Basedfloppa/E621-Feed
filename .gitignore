**/target
*/dist
.idea/*
.vscode/*
*/node_modules

*.db*
*.bin*
# NOTE: Cargo.lock / package-lock.json are deliberately NOT ignored — the
# wasm-bindgen version pinned in parser-web/Cargo.lock determines the JS glue
# and wasm bytes served to browsers, and parser-web/package-lock.json is
# required by `npm ci` in the Docker build. An unpinned lockfile is what
# caused the live-site SRI integrity mismatches (see docs/deployment.md).
tailwind-output.css
config.toml
.env

parser-web/.well-known/security.txt
*/db
parser-api/loadtest/server.log
parser-api/loadtest/__pycache__/
**media
**db_exports

**/.*/**
# Throwaway configs used by the local e2e/browser checks (config.toml is ignored
# above; these are the per-run variants that point at a scratch database).
config.mcp.toml
config.e2e.toml
config.*-e2e.toml
