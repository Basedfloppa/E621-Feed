domain.com {
    root * /var/www/E621-Account-Parser/parser-web/dist

    # ====== Security headers ======
    header {
        Strict-Transport-Security     "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy       "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.e621.net; media-src https://*.e621.net; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Referrer-Policy               "no-referrer"
        X-Content-Type-Options        "nosniff"
        X-Frame-Options               "DENY"
        Cross-Origin-Opener-Policy    "same-origin"
        Cross-Origin-Resource-Policy  "same-origin"
        Permissions-Policy            "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
    }

    encode zstd gzip

    # OPTIONS preflight (for SPA routes, NOT /api)
    @options_site {
        method OPTIONS
        not path /api/*
    }
    respond @options_site 204

    # robots.txt
    @robots {
        path /robots.txt
    }
    handle @robots {
        header Content-Type "text/plain; charset=utf-8"
        respond 200
    }

    # Block Swagger in production
    @blocked {
        path /api/swagger-ui* /api/openapi.json
    }
    respond @blocked 404

    # API — proxy to Go backend :8181
    route /api/* {
        reverse_proxy http://127.0.0.1:8181 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            transport http {
                read_timeout  300s
                write_timeout 300s
            }
        }
    }

    # ====== Caching rules ======

    @no_cache {
        path /static/config.js
    }
    header @no_cache {
        Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Pragma        "no-cache"
        Expires       "0"
    }

    @index {
        path /index.html
    }
    header @index Cache-Control "no-cache, must-revalidate"

    @wasm {
        path *.wasm
    }
    header @wasm Cache-Control "public, max-age=31536000, immutable"

    @mjs {
        path *.mjs
    }
    header @mjs Cache-Control "public, max-age=31536000, immutable"

    @assets {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    @sw {
        path /manifest.json /manifest.webmanifest /service-worker.js
    }
    header @sw Cache-Control "public, max-age=3600, must-revalidate"

    # SPA fallback
    route {
        try_files {path} /index.html
        file_server
    }

    request_body {
        max_size 50MB
    }

    log {
        output file /var/log/caddy/parser.access.log
    }
}

# www → apex redirect
www.domain.com {
    redir https://domain.com{uri}
}
